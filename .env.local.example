# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_LAUNCH_STAGE=development
NEXT_PUBLIC_REGISTRATION_MODE=beta
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Read-only access window after Stripe marks a subscription past due (1-30 days)
BILLING_GRACE_DAYS=7

# Stripe Price IDs — one recurring price per plan (Products -> pricing)
STRIPE_PRICE_ESSENTIALS=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_COMPLETE=

# Random secret used to sign entitlement records (openssl rand -hex 32)
ENTITLEMENT_SIGNING_SECRET=

# Used to build Stripe redirect URLs when the request has no Origin header
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plaid bank connections (use sandbox until production access is approved)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Base64-encoded 32-byte AES key: openssl rand -base64 32
BANK_TOKEN_ENCRYPTION_KEY=

# Random secret sent by Vercel Cron to authenticated maintenance routes
# openssl rand -hex 32
CRON_SECRET=

# Distinct bearer secrets for protected readiness checks and backup evidence
# openssl rand -hex 32
HEALTHCHECK_SECRET=
OPERATIONS_SECRET=
